{
  "name": "landing-page-generator-actions",
  "version": "0.1.0",
  "private": true,
  "description": "Optional no-authentication Action service for Landing Page Generator.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx ../scripts/run-action-tests.ts",
    "validate": "tsx ../scripts/validate-json-data.ts && tsx ../scripts/validate-openapi.ts",
    "schemas": "tsx ../scripts/build-combined-openapi.ts",
    "package:gpt": "tsx ../scripts/package-gpt-release.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
